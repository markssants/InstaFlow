# ==========================================
# InstaFlow / Next.js - Regras do .gitignore
# ==========================================

# 1. Dependências do Node (Pesadas - geradas pelo npm install)
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# 2. Build e Cache do Next.js
.next/
out/
build/
dist/
.turbo

# 3. Variáveis de Ambiente e Chaves Privadas
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# 4. Arquivos de Mídia e Vídeos de Teste (Pesados - nunca sobem pro Git)
*.mp4
*.mov
*.m4v
*.webm
*.avi
*.mkv

# 5. Logs e Depuração
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.system_generated/

# 6. Scripts e Arquivos de Teste Temporários
test_*.js
test_*.mp4
scratch/
temp/
tmp/

# 7. Arquivos do Sistema Operacional (macOS / Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# 8. Configurações de IDEs e Editores
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# 9. Vercel & TypeScript
.vercel
*.tsbuildinfo
next-env.d.ts
